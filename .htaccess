RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.ampstowatt\.com$ [NC]
RewriteRule ^ https://ampstowatt.com%{REQUEST_URI} [R=301,L]

RewriteRule ^index\.php$ https://ampstowatt.com/ [R=301,L]
RewriteRule ^index\.html$ https://ampstowatt.com/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteRule ^(.+)$ https://ampstowatt.com/$1/ [R=301,L]

RewriteRule ^voltage-drop\.html$ https://ampstowatt.com/voltage-drop-calculator/ [R=301,L]
RewriteRule ^wire-gauge\.html$ https://ampstowatt.com/wire-gauge-calculator/ [R=301,L]
RewriteRule ^watts-to-amps-calculator\.html$ https://ampstowatt.com/#watts-to-amps [R=301,L]
RewriteRule ^pages/([^/]+)\.html$ https://ampstowatt.com/$1/ [R=301,L]
RewriteRule ^([^/]+)\.html$ https://ampstowatt.com/$1/ [R=301,L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
