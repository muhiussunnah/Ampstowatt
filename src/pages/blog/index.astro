---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Electrical Blog & Guides | Ampstowatt";
const description = "In-depth guides on circuit breaker safety, solar panel wiring, EV charging, and electrical conversions.";
const h1Title = "Electrical Guides & Articles";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/blog/"
  h1Title={h1Title}
  kicker="Educational Resources"
>
  <div class="blog-hero">
    <h1>{h1Title}</h1>
    <p>Read our in-depth guides on electrical safety, solar power, and home circuitry designed for electricians and homeowners.</p>
  </div>
  
  <div class="blog-grid">
    <article class="blog-card">
      <span class="badge">Safety Guide</span>
      <h2><a href="/blog/circuit-breaker-safety-guide/">Circuit Breaker Safety Guide: Sizing and the 80% Rule</a></h2>
      <p>Learn how to safely size your circuit breakers and why you can only use 80% of a breaker's capacity for continuous loads like EV chargers and heaters.</p>
      <span class="read-more">Read article</span>
    </article>

    <article class="blog-card">
      <span class="badge">Solar Guide</span>
      <h2><a href="/blog/understanding-solar-panel-wiring/">Solar Panel Wiring: Complete Amps and Watts Guide</a></h2>
      <p>Understand the difference between series and parallel wiring, and how it affects the voltage and amperage of your solar array and charge controller sizing.</p>
      <span class="read-more">Read article</span>
    </article>

    <article class="blog-card">
      <span class="badge">EV Planning</span>
      <h2><a href="/blog/ev-charging-at-home-electrical-guide/">EV Charging at Home: Full Electrical Planning Guide</a></h2>
      <p>Planning to install a Level 2 EV charger? Find out exactly what wire gauge and breaker size you need for 240V charging.</p>
      <span class="read-more">Read article</span>
    </article>

    <article class="blog-card">
      <span class="badge">Reference Guide</span>
      <h2><a href="/blog/amps-to-watts-conversion-chart-pdf/">Printable Amps to Watts Conversion Chart (Cheat Sheet)</a></h2>
      <p>Get a quick reference cheat sheet for converting amps to watts at 12V, 120V, and 240V. Perfect for toolboxes and site planning.</p>
      <span class="read-more">Read article</span>
    </article>
  </div>
</BaseLayout>
