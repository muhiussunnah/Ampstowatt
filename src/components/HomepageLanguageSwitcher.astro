---
interface Props {
  placement?: "main" | "footer";
}

const { placement = "main" } = Astro.props;

const languages = [
  ["en", "English"],
  ["hi", "हिंदी"],
  ["es", "Español"],
  ["ru", "Русский"],
  ["fr", "Français"],
  ["de", "Deutsch"],
  ["it", "Italiano"],
  ["pt", "Português"],
  ["bn", "বাংলা"],
  ["ja", "日本語"],
  ["ko", "한국어"],
  ["ms", "Malay"],
  ["pl", "Polski"],
  ["id", "Indonesia"],
  ["ar", "العربية"],
  ["bg", "Български"],
  ["tr", "Türkçe"],
  ["sv", "Svenska"],
];
---

<section
  class:list={[
    "language-switcher",
    placement === "footer" && "language-switcher--footer",
  ]}
  aria-label="Homepage language selector"
>
  <div class="language-switcher-row" data-language-switcher>
    {
      languages.map(([code, label]) => (
        <button
          type="button"
          data-lang={code}
          lang={code}
          class:list={[code === "en" && "is-active"]}
        >
          {label}
        </button>
      ))
    }
  </div>
</section>

