---
import type { Tool } from '@/data/tools';

interface Props {
  tool?: Tool;
}
const { tool } = Astro.props;

const defaultVoltage = tool?.defaultVoltage ?? 120;
const defaultPhase = tool?.defaultPhase ?? 'ac1';
---

<div class="lx-tool premium-calculator" data-mode="amps-to-watts" id="amps-to-watts-tool">
  <!-- Premium visual gauge -->
  <div class="premium-gauge-container">
    <div class="premium-gauge">
      <svg viewBox="0 0 100 50" class="gauge-svg">
        <path class="gauge-bg" d="M 10 50 A 40 40 0 0 1 90 50" fill="none" stroke="rgba(22, 217, 244, 0.1)" stroke-width="8" stroke-linecap="round" />
        <path class="gauge-fill" id="gauge-fill" d="M 10 50 A 40 40 0 0 1 90 50" fill="none" stroke="url(#gauge-gradient)" stroke-width="8" stroke-linecap="round" stroke-dasharray="125.6" stroke-dashoffset="125.6" />
        <defs>
          <linearGradient id="gauge-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#16d9f4" />
            <stop offset="100%" stop-color="#6effd7" />
          </linearGradient>
        </defs>
      </svg>
      <div class="gauge-value">
        <span id="lx-mirror-val">0 W</span>
        <small class="lx-mode-text">AMPS TO WATTS</small>
      </div>
    </div>
  </div>

  <div class="lx-calculator-body">
    <div class="lx-header-row">
      <h3 class="lx-card-title">Live Conversion Engine</h3>
      <button type="button" class="lx-mode-btn lx-toggle-btn active" id="lx-mode-btn" role="switch" aria-checked="true">Switch to Watts to Amps</button>
    </div>

    <div class="lx-grid">
      <!-- Input Mode / Phase Type -->
      <div class="lx-field">
        <label for="lx-type">Circuit Type</label>
        <select id="lx-type" class="premium-input">
          <option value="dc" selected={defaultPhase === 'dc'}>DC (Direct Current)</option>
          <option value="ac1" selected={defaultPhase === 'ac1'}>AC Single-Phase</option>
          <option value="ac3" selected={defaultPhase === 'ac3'}>AC Three-Phase</option>
        </select>
      </div>

      <!-- Voltage Type (Three-Phase Only) -->
      <div class="lx-field" id="lx-vtype-container" style="display: none;">
        <label>Voltage Type</label>
        <div class="lx-toggle-group">
          <input type="hidden" id="lx-vtype" value="vll" />
          <button type="button" class="lx-btn active" id="btn-vll">Line-to-Line</button>
          <button type="button" class="lx-btn" id="btn-vln">Line-to-Neutral</button>
        </div>
      </div>

      <!-- Power / Current Input -->
      <div class="lx-field">
        <label id="lbl-power" for="lx-power">Current</label>
        <div class="lx-input-group">
          <input type="number" id="lx-power" value="10" min="0" step="any" class="premium-input" />
          <select id="lx-power-unit" class="lx-unit-select premium-input">
            <option value="a">A</option>
            <option value="ma">mA</option>
          </select>
        </div>
      </div>

      <!-- Voltage Input -->
      <div class="lx-field">
        <label for="lx-volts">Voltage (V)</label>
        <input type="number" id="lx-volts" value={defaultVoltage} min="0" step="any" class="premium-input" />
      </div>

      <!-- Power Factor Input -->
      <div class="lx-field lx-span-2" id="lx-pf-container">
        <label for="lx-pf-input">Power Factor (PF)</label>
        <div class="lx-slider-group">
          <input type="range" id="lx-pf-slider" min="0.01" max="1" step="0.01" value="1" />
          <input type="number" id="lx-pf-input" min="0.01" max="1" step="0.01" value="1" class="premium-input" />
        </div>
      </div>
    </div>

    <!-- Results Area -->
    <div class="premium-results-grid" aria-live="polite" aria-atomic="true">
      <div class="lx-field" id="res-amps-box">
        <label id="lbl-res1">Power (kW)</label>
        <div class="lx-input-group">
          <input type="text" id="res-kw" readonly class="premium-input result-input" />
          <span class="lx-unit-label" id="lbl-unit1">kW</span>
        </div>
      </div>
      <div class="lx-field" id="res-ma-box">
        <label id="lbl-res2">Power (W)</label>
        <div class="lx-input-group">
          <input type="text" id="res-watts" readonly class="premium-input result-input" />
          <span class="lx-unit-label" id="lbl-unit2">W</span>
        </div>
      </div>
    </div>

    <!-- Hidden decimals config for JS -->
    <input type="hidden" id="lx-dec" value="4" />

    <!-- Actions -->
    <div class="lx-actions">
      <button type="button" class="btn-ghost lx-btn-reset">Reset</button>
      <!-- Copy and Export buttons will be injected by app.js here -->
    </div>
  </div>
</div>
