---
import type { Tool } from '@/data/tools';

interface Props {
  tool?: Tool;
  variant?: 'home';
}

const { tool, variant } = Astro.props;
const voltage = tool?.defaultVoltage ?? 120;
const title = tool?.title ?? 'Amps to Watts Calculator';
const formula = tool?.formula ?? 'Watts = Amps x Volts';

function visualFor() {
  if (variant === 'home' || !tool) {
    return {
      id: 'home-amps-to-watts-visual',
      eyebrow: 'Premium technical visual',
      heading: 'Amps, volts, watts, and circuit limits in one view',
      note: 'Use the diagram as a fast visual map: choose the circuit type, enter measured amps and volts, then compare the watt result with practical circuit limits.',
      mode: 'home',
      labels: ['10 A', '120 V', '1,200 W', '15 A breaker', '1,440 W continuous']
    };
  }

  if (tool.slug.includes('solar')) {
    return {
      id: `${tool.slug}-solar-visual`,
      eyebrow: 'Solar current path',
      heading: 'Panel watts converted into battery-side charging amps',
      note: 'Solar pages need separate panel-side and battery-side thinking, so this visual shows panel power moving through the controller before the amp result.',
      mode: 'solar',
      labels: ['400 W panel', `${voltage} V bank`, `${(400 / voltage).toFixed(2)} A`, 'MPPT/PWM', 'Fuse + wire check']
    };
  }

  if (tool.slug.includes('led')) {
    return {
      id: `${tool.slug}-led-visual`,
      eyebrow: 'LED driver path',
      heading: 'Driver watts divided by low-voltage DC supply',
      note: 'LED loads are usually low-voltage DC, so the useful visual is a driver feeding a strip with current, voltage, and wire checks shown together.',
      mode: 'led',
      labels: ['LED driver', '12 V / 24 V', 'A = W / V', 'Strip load', 'Voltage drop']
    };
  }

  if (tool.slug.includes('speaker')) {
    return {
      id: `${tool.slug}-speaker-visual`,
      eyebrow: 'Amplifier supply path',
      heading: 'Audio output watts translated into DC supply current',
      note: 'Amplifier pages need efficiency and fuse context, because speaker watts and supply current are not the same measurement.',
      mode: 'speaker',
      labels: ['Amplifier', '500 W RMS', '12 V supply', '85% eff.', '49 A draw']
    };
  }

  if (tool.kind === 'voltage-drop' || tool.kind === 'wire-gauge') {
    return {
      id: `${tool.slug}-wire-visual`,
      eyebrow: 'Conductor planning map',
      heading: 'Current, distance, conductor material, and voltage drop',
      note: 'Wire and voltage-drop pages rank better when the content shows the physical run: source, conductor length, voltage loss, and load.',
      mode: 'wire',
      labels: ['Source', 'Current', 'One-way distance', 'Copper / aluminum', '% voltage drop']
    };
  }

  if (tool.kind === 'amp-hours') {
    return {
      id: `${tool.slug}-battery-visual`,
      eyebrow: 'Battery energy model',
      heading: 'Amp-hours converted into watt-hours and runtime',
      note: 'Battery pages need energy context, so this panel connects Ah, voltage, efficiency, Wh, and practical runtime.',
      mode: 'battery',
      labels: ['100 Ah', `${voltage} V`, `${(100 * voltage).toLocaleString()} Wh`, 'Efficiency', 'Runtime load']
    };
  }

  if (tool.kind === 'power-factor' || tool.kind === 'kva-to-watts' || tool.kind === 'volt-amps') {
    return {
      id: `${tool.slug}-power-triangle-visual`,
      eyebrow: 'Real vs apparent power',
      heading: 'Watts, VA, kVA, and power factor shown as one relationship',
      note: 'These conversions depend on the difference between real and apparent power, so the power triangle makes the formula easier to trust.',
      mode: 'triangle',
      labels: ['kVA / VA', 'Watts', 'Reactive load', 'PF = W / VA', 'Generator sizing']
    };
  }

  if (tool.defaultPhase === 'ac3' || tool.slug.includes('3-phase') || tool.slug.includes('megawatts')) {
    return {
      id: `${tool.slug}-three-phase-visual`,
      eyebrow: 'Three-phase power path',
      heading: 'Balanced line-to-line power using the 1.732 multiplier',
      note: 'Three-phase pages need line-to-line voltage clarity, so the diagram shows L1, L2, L3 feeding a balanced load.',
      mode: 'three',
      labels: ['L1', 'L2', 'L3', `${voltage} V L-L`, '1.732 x A x V x PF']
    };
  }

  if (tool.defaultPhase === 'dc' || tool.slug.includes('12v') || tool.slug.includes('dc')) {
    return {
      id: `${tool.slug}-dc-visual`,
      eyebrow: 'DC circuit loop',
      heading: 'Battery voltage and current converted directly into watts',
      note: 'DC pages need a clean loop: battery, load, current direction, and watts without power factor.',
      mode: 'dc',
      labels: [`${voltage} V battery`, '10 A', `${10 * voltage} W`, 'Fuse', 'Load']
    };
  }

  return {
    id: `${tool.slug}-ac-visual`,
    eyebrow: 'Single-phase AC path',
    heading: 'Current, voltage, and power factor feeding a real watt result',
    note: 'AC pages need power factor context, so the visual connects outlet voltage, current draw, PF, and breaker planning.',
    mode: 'ac',
    labels: ['AC source', `${voltage} V`, '10 A', 'PF 0.90', `${Math.round(10 * voltage * 0.9).toLocaleString()} W`]
  };
}

const visual = visualFor();
---

<section class="electric-visual-section" aria-labelledby={`${visual.id}-heading`}>
