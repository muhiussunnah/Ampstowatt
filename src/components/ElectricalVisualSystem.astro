            <rect class="ev-node ev-node--success" x="588" y="90" width="128" height="102" rx="14" />
            <path class="ev-wire ev-wire--hot" d="M236 140 H328" />
            <path class="ev-wire ev-wire--hot" d="M478 140 H588" />
            <circle class="ev-meter" cx="404" cy="274" r="45" />
            <path class="ev-wire" d="M152 222 H650" />
