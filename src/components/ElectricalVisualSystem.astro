            <text class="ev-muted" x="152" y="156" text-anchor="middle">{visual.labels[1]}</text>
            <text class="ev-title" x="403" y="125" text-anchor="middle">Ah x V</text>
            <text class="ev-muted" x="403" y="153" text-anchor="middle">{visual.labels[2]}</text>
            <text class="ev-label" x="652" y="130" text-anchor="middle">{visual.labels[4]}</text>
            <text class="ev-title" x="404" y="281" text-anchor="middle">{visual.labels[3]}</text>
          </>
        )}

        {visual.mode === 'triangle' && (
          <>
            <path class="ev-triangle" d="M168 282 L592 282 L592 78 Z" />
            <path class="ev-wire ev-wire--hot" d="M168 282 H592" />
