    <div class="electric-visual-copy">
      <p class="premium-kicker">{visual.eyebrow}</p>
      <h2 id={`${visual.id}-heading`}>{visual.heading}</h2>
      <p>{visual.note}</p>
      <div class="electric-formula-bar" aria-label="Formula used in this visual">
        <span>Formula</span>
        <strong>{formula}</strong>
      </div>
    </div>

    <figure class={`electric-diagram electric-diagram--${visual.mode}`}>
      <svg viewBox="0 0 760 390" role="img" aria-labelledby={`${visual.id}-svg-title ${visual.id}-svg-desc`}>
        <title id={`${visual.id}-svg-title`}>{title} technical circuit diagram</title>
        <desc id={`${visual.id}-svg-desc`}>A premium electrical diagram showing the main values and conversion flow for {title}.</desc>

        <rect class="ev-board" x="18" y="18" width="724" height="354" rx="18" />
