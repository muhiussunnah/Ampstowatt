            <text class="ev-title" x="376" y="112" text-anchor="middle">A x V = W</text>
            <text class="ev-muted" x="376" y="144" text-anchor="middle">DC / AC / 3-phase</text>
            <text class="ev-label" x="626" y="119" text-anchor="middle">{visual.labels[2]}</text>
