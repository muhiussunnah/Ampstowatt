            <text class="ev-title" x="387" y="121" text-anchor="middle">{visual.labels[3]}</text>
            <text class="ev-muted" x="387" y="148" text-anchor="middle">{visual.labels[2]}</text>
            <text class="ev-label" x="649" y="124" text-anchor="middle">{visual.labels[1]}</text>
