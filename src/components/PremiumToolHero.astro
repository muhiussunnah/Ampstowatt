---
import PageVisual from './PageVisual.astro';
import type { Tool } from '@/data/tools';

type Props = {
  tool: Tool;
};

const { tool } = Astro.props;
const kind =
  tool.kind === 'voltage-drop' || tool.kind === 'wire-gauge'
    ? 'wire'
    : tool.defaultPhase === 'dc' || tool.eyebrow.toLowerCase().includes('battery') || tool.eyebrow.toLowerCase().includes('solar')
      ? 'dc'
      : tool.defaultPhase === 'ac3' || tool.title.toLowerCase().includes('3 phase') || tool.title.toLowerCase().includes('three')
        ? 'three'
        : 'ac';
---

<section class="premium-tool-hero">
  <div class="premium-hero-copy">
    <p class="premium-kicker">{tool.eyebrow}</p>
    <h1>{tool.title}</h1>
    <p>{tool.description}</p>
    <div class="premium-formula-pill">{tool.formula}</div>
    <div class="premium-hero-actions">
      <a href="#calculator">Use calculator</a>
      <a href="#faq">Read FAQ</a>
    </div>
    <div class="premium-trust-badges">
      <span class="premium-trust-badge">Free forever</span>
      <span class="premium-trust-badge">No sign-up required</span>
      <span class="premium-trust-badge">Instant results</span>
    </div>
  </div>
  <div class="premium-hero-visual">
    <PageVisual title={tool.title} eyebrow={tool.eyebrow} formula={tool.formula} kind={kind} />
    <div class="premium-mini-grid">
      {tool.highlights.map((item) => <span>{item}</span>)}
    </div>
  </div>
</section>
