const knowledgeSlugs = new Set([
  "amps-to-watts-formula",
  "conversion-charts",
  "amps-vs-watts",
  "how-many-watts-per-amp",
  "what-are-amps",
  "what-are-watts",
  "ohms-law-explained",
  "watts-law-explained",
  "kwh-explained",
  "power-factor",
  "power-factor-explained",
  "understanding-power-factor",
]);
const voltageSlugs = new Set(
  voltagePages.map((item) => item.href.slice(1, -1)),
);
const phaseSlugs = new Set([
  "ac-amps-to-watts-calculator",
  "dc-amps-to-watts-calculator",
  "single-phase-amps-to-watts",
  "3-phase-amps-to-watts-calculator",
]);
const applicationSlugs = new Set(
  applicationPages.map((item) => item.href.slice(1, -1)),
);
const reverseSlugs = new Set(
  reversePages.map((item) => item.href.slice(1, -1)),
);
const safetySlugs = new Set([
  "wire-gauge-calculator",
  "voltage-drop-calculator",
]);

const linkByHref = new Map(
  [
    ...voltagePages,
    ...phasePages,
    ...applicationPages,
    ...knowledgeApplyPages,
    ...reversePages,
    ...safetyPages,
  ].map((item) => [item.href, item]),
);

let sectionTitle = "Related Amps to Watts Calculators";
let lead =
  "Need the general formula, conversion table, and breaker-safety context? Use the main calculator hub first, then return to this specialized page for the exact voltage, circuit type, or equipment.";
let relatedLinks: LinkItem[] = phasePages;
let supportingLinks: LinkItem[] = [];

if (voltageSlugs.has(slug)) {
  sectionTitle = "Related Voltage Calculators";
  lead =
    "Compare this voltage with the other common DC, household, mains, and industrial voltage calculators.";
  relatedLinks = voltagePages;
  supportingLinks = phasePages.filter((item) =>
    [
      "/",
      "/ac-amps-to-watts-calculator/",
      "/dc-amps-to-watts-calculator/",
      "/single-phase-amps-to-watts/",
      "/3-phase-amps-to-watts-calculator/",
      "/amps-to-watts-formula/",
      "/watts-to-amps-calculator/",
    ].includes(item.href),
  );
} else if (phaseSlugs.has(slug)) {
  sectionTitle = "Related Amps to Watts Calculators";
  lead =
    "Move between AC, DC, phase-specific, formula, chart, and reverse conversion pages without using redirected URLs.";
  relatedLinks = phasePages;
} else if (applicationSlugs.has(slug)) {
  sectionTitle = "Related Appliance & Equipment Calculators";
  lead =
    "Use these equipment pages to compare realistic household, motor, charging, solar, lighting, and generator loads.";
  const selected =
    applicationRelevantLinks[slug] ?? applicationPages.map((item) => item.href);
  relatedLinks = selected
    .map((href) => linkByHref.get(href))
    .filter(Boolean) as LinkItem[];
  supportingLinks = [
    {
      href: "/",
      title: "Amps to Watts Calculator",
      desc: "Main amps to watts hub",
      icon: "W",
    },
    {
      href: "/ac-amps-to-watts-calculator/",
      title: "AC Amps to Watts Calculator",
      desc: "AC loads with power factor",
      icon: "AC",
    },
    {
      href: "/dc-amps-to-watts-calculator/",
      title: "DC Amps to Watts Calculator",
      desc: "DC battery and solar loads",
      icon: "DC",
    },
    {
      href: "/watts-to-amps-calculator/",
      title: "Watts to Amps Calculator",
      desc: "Reverse conversion for equipment labels",
      icon: "A",
    },
    {
      href: "/power-factor/",
      title: "Power Factor",
      desc: "Real watts for motors and compressors",
      icon: "PF",
    },
    {
      href: "/voltage-drop-calculator/",
      title: "Voltage Drop Calculator",
      desc: "Check long wire runs",
      icon: "VD",
    },
    {
      href: "/wire-gauge-calculator/",
      title: "Wire Gauge Calculator",
      desc: "Size conductors after current planning",
      icon: "AWG",
    },
    ...(supplementalLinks[slug] ?? []),
  ];
} else if (knowledgeSlugs.has(slug)) {
  sectionTitle = "Apply This Knowledge";
  lead =
    "Use these calculator pages to apply the concept to real current, voltage, watts, and power-factor problems.";
  relatedLinks = knowledgeApplyPages;
} else if (reverseSlugs.has(slug)) {
  sectionTitle = "Related Electrical Conversions";
  lead =
    "Continue through the reverse and related conversion tools that support amps, watts, kW, VA, kVA, and battery energy planning.";
  relatedLinks = reversePages;
  supportingLinks = voltagePages.filter((item) =>
    [
      "/12v-amps-to-watts/",
      "/120v-amps-to-watts/",
      "/240v-amps-to-watts/",
    ].includes(item.href),
  );
} else if (safetySlugs.has(slug)) {
  sectionTitle = "Wire, Safety & Power Quality Tools";
  lead =
    "After calculating watts and amps, use these pages to check conductor sizing, voltage loss, power factor, and high-current equipment planning.";
  relatedLinks = safetyPages;
}

const dedupedLinks = [...relatedLinks, ...supportingLinks].filter(
  (item, index, list) =>
    item.href !== currentPath &&
    list.findIndex((candidate) => candidate.href === item.href) === index,
);
---

{
  dedupedLinks.length > 0 && (
    <section
      class="content-section semantic-link-map"
      aria-label={sectionTitle}
    >
      <div class="section-divider">
        <div class="icon-circle" aria-hidden="true">
          Hub
        </div>
        <h2>{sectionTitle}</h2>
        <div class="line" aria-hidden="true" />
      </div>
      <div class="semantic-link-map-grid semantic-link-map-grid--single">
        <section class="semantic-link-cluster semantic-link-cluster--plain">
          <div class="semantic-hub-callout">
            <strong>Start with the main conversion tool</strong>
            <p>
              {lead} <a href="/">Amps to Watts Calculator</a>
            </p>
          </div>
          <nav class="semantic-link-list" aria-label={sectionTitle}>
            {dedupedLinks.map((link) => (
              <a href={link.href}>
                <span class="semantic-link-title">
                  <span class="semantic-link-badge">{link.icon}</span>
                  <strong>{link.title}</strong>
                </span>
                <span class="semantic-link-desc">{link.desc}</span>
              </a>
            ))}
          </nav>
        </section>
      </div>
    </section>
  )
}
