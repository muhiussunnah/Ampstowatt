---
export interface Props {
  slug?: string;
}

const { slug = '' } = Astro.props;

// Define the semantic silos with icons
const silos = {
  lowVoltage: [
    { href: "/12v-amps-to-watts-calculator/", title: "12V Amps to Watts", desc: "Low-voltage DC loads", icon: "12V" },
    { href: "/solar-watts-to-amps-calculator/", title: "Solar Watts to Amps", desc: "PV and charge current", icon: "PV" },
    { href: "/led-watts-to-amps-calculator/", title: "LED Watts to Amps", desc: "LED strip and driver loads", icon: "LED" },
    { href: "/dc-amps-to-watts-calculator/", title: "DC Amps to Watts", desc: "Battery and solar DC", icon: "DC" }
  ],
  mainsVoltage: [
    { href: "/120v-amps-to-watts-calculator/", title: "120V Amps to Watts", desc: "North American outlets", icon: "120" },
    { href: "/220v-amps-to-watts-calculator/", title: "220V Amps to Watts", desc: "220 volt appliances", icon: "220" },
    { href: "/240v-amps-to-watts-calculator/", title: "240V Amps to Watts", desc: "Dryers, heaters, EV circuits", icon: "240" },
    { href: "/single-phase-amps-to-watts-calculator/", title: "Single Phase Amps to Watts", desc: "Residential AC loads", icon: "AC" }
  ],
  industrial: [
    { href: "/3-phase-amps-to-watts-calculator/", title: "3 Phase Amps to Watts", desc: "Industrial line voltage", icon: "3P" },
    { href: "/megawatts-to-amps-calculator/", title: "Megawatts to Amps", desc: "Large system current", icon: "MW" },
    { href: "/kva-to-watts-calculator/", title: "kVA to Watts", desc: "Apparent to real power", icon: "kVA" },
    { href: "/ac-amps-to-watts-calculator/", title: "AC Amps to Watts", desc: "RMS voltage and PF", icon: "AC" }
  ],
  audio: [
    { href: "/speaker-amp-power-calculator/", title: "Speaker Amp Power", desc: "Audio amplifier planning", icon: "SPK" },
    { href: "/12v-amps-to-watts-calculator/", title: "12V Amps to Watts", desc: "Car audio 12V loads", icon: "12V" },
    { href: "/amp-power-consumption-calculator/", title: "Amp Power Consumption", desc: "Runtime and energy use", icon: "RUN" }
  ]
};

// Map slugs to their primary silo
const siloMapping: Record<string, keyof typeof silos> = {
  '12v-amps-to-watts-calculator': 'lowVoltage',
  'solar-watts-to-amps-calculator': 'lowVoltage',
  'led-watts-to-amps-calculator': 'lowVoltage',
  'dc-amps-to-watts-calculator': 'lowVoltage',
  '120v-amps-to-watts-calculator': 'mainsVoltage',
  '220v-amps-to-watts-calculator': 'mainsVoltage',
  '230v-amps-to-watts-calculator': 'mainsVoltage',
  '240v-amps-to-watts-calculator': 'mainsVoltage',
  'amps-to-watts-120v-calculator': 'mainsVoltage',
  'amps-to-watts-220v-calculator': 'mainsVoltage',
  'amps-to-watts-230v-calculator': 'mainsVoltage',
  'amps-to-watts-240v-calculator': 'mainsVoltage',
  'single-phase-amps-to-watts-calculator': 'mainsVoltage',
  '3-phase-amps-to-watts-calculator': 'industrial',
  'amps-to-watts-3-phase-calculator': 'industrial',
  'megawatts-to-amps-calculator': 'industrial',
  'kva-to-watts-calculator': 'industrial',
  'ac-amps-to-watts-calculator': 'industrial',
  'amps-to-watts-ac-calculator': 'industrial',
  'speaker-amp-power-calculator': 'audio',
  'amp-power-consumption-calculator': 'audio'
};

// Default to mainsVoltage if unmapped
const currentSiloKey = siloMapping[slug] || 'mainsVoltage';
const currentSilo = silos[currentSiloKey];

// Filter out the current page so we don't link to ourselves
const relatedLinks = currentSilo.filter(link => link.href !== `/${slug}/`);

const titles = {
  lowVoltage: "Related Low Voltage & DC Tools",
  mainsVoltage: "Related Mains Voltage & AC Tools",
  industrial: "Related Industrial & 3-Phase Tools",
  audio: "Related Audio & Amplification Tools"
};
const sectionTitle = titles[currentSiloKey];
---

{relatedLinks.length > 0 && (
  <section class="content-section semantic-link-map" aria-label="Contextual electrical calculators">
    <div class="section-divider">
      <div class="icon-circle" aria-hidden="true">Hub</div>
      <h2>{sectionTitle}</h2>
      <div class="line" aria-hidden="true"></div>
    </div>
    <div class="semantic-link-map-grid" style="grid-template-columns: 1fr;">
      <section class="semantic-link-cluster" style="padding:0; border:none; background:transparent;">
        <nav class="semantic-link-list" aria-label="Related tools">
          {relatedLinks.map(link => (
            <a href={link.href}>
              <span style="display: flex; align-items: center; gap: 0.6rem;">
                <span style="display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 8px; background: rgba(22, 217, 244, 0.08); border: 1px solid rgba(22, 217, 244, 0.15); font-size: 1rem; flex-shrink: 0;">{link.icon}</span>
                <strong>{link.title}</strong>
              </span>
              <span style="padding-left: 2.6rem;">{link.desc}</span>
            </a>
          ))}
        </nav>
      </section>
    </div>
  </section>
)}
