    url: "/amps-to-kw-calculator/",
    tone: "orange",
  },
  {
    title: "kVA to Watts",
    text: "Convert apparent to real power",
    url: "/kva-to-watts-calculator/",
    tone: "purple",
  },
  {
    title: "Voltage Drop",
    text: "Calculate voltage loss in wire runs",
    url: "/voltage-drop-calculator/",
    tone: "blue",
  },
  {
    title: "Wire Gauge",
    text: "Select the right wire size",
    url: "/wire-gauge-calculator/",
    tone: "cyan",
  },
];

const guideCards = [
  {
    title: "Ohm's Law Explained",
    text: "Understand the relationship between voltage, current, and resistance in electrical circuits.",
    url: "/ohms-law-explained/",
    icon: "lamp",
  },
  {
    title: "Power Factor Explained",
    text: "Learn how power factor affects efficiency and why it matters in AC power calculations.",
    url: "/power-factor-explained/",
