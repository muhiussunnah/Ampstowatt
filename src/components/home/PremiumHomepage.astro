      ["Conversion Charts", "/conversion-charts/"],
    ],
  },
  {
    id: "topical-phase-calculators",
    title: "AC / DC / Phase Calculators",
    links: [
      ["AC Power Calculator", "/ac-amps-to-watts-calculator/"],
