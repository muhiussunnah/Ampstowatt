---
import PremiumToolCalculator from "@/components/calculators/PremiumToolCalculator.astro";
import { getCalculatorConfig } from "@/data/calculatorConfigs";

const formulaCards = [
  {
    tone: "orange",
    badge: "DC",
    title: "Direct Current",
    formula: "W = A × V",
    description: "For DC circuits, multiply amps by volts to get watts. No power factor needed because current and voltage stay in phase.",
    example: "5A × 12V = 60 watts",
  },
  {
    tone: "blue",
    badge: "1Φ",
    title: "Single-Phase AC",
    formula: "W = A × V × PF",
    description: "For AC single-phase circuits, include the power factor to account for reactive power in inductive loads.",
    example: "10A × 120V × 1.0 = 1,200 watts",
  },
  {
    tone: "purple",
    badge: "3Φ L-L",
    title: "Three-Phase AC (Line-to-Line)",
    formula: "W = √3 × A × V × PF",
    description: "Three-phase line-to-line systems use the √3 (1.732) multiplier because power is shared across three phases.",
    example: "10A × 480V × 0.90 × 1.732 = 7,478W",
  },
  {
    tone: "green",
    badge: "3Φ L-N",
    title: "Three-Phase AC (Line-to-Neutral)",
    formula: "W = 3 × A × V × PF",
    description: "When using line-to-neutral voltage in three-phase systems, multiply by 3 instead of √3.",
    example: "10A × 277V × 0.90 × 3 = 7,479W",
  },
];

const exampleCards = [
  {
    tone: "orange",
    label: "12V DC Battery",
    formula: "5A × 12V = 60W",
    text: "A 12V device drawing 5 amps uses about 60 watts. Common in automotive, RV, and solar battery systems.",
  },
  {
    tone: "blue",
    label: "120V Appliance",
    formula: "10A × 120V × 1.0 = 1,200W",
    text: "A 120V resistive appliance drawing 10 amps uses about 1,200 watts. Typical for hair dryers, toasters, and space heaters.",
  },
  {
    tone: "purple",
    label: "240V Load",
    formula: "30A × 240V × 1.0 = 7,200W",
    text: "A 240V load drawing 30 amps can use about 7.2 kW. Common for electric dryers, EV chargers, and water heaters.",
  },
  {
    tone: "green",
    label: "480V Three-Phase",
    formula: "10A × 480V × 0.90 × 1.732 = 7,478W",
    text: "A 480V three-phase load at 10 amps and 0.90 power factor uses about 7.48 kW. Typical for industrial motors and commercial HVAC.",
  },
];

const categoryCards = [
  {
    tone: "orange",
    icon: "bolt",
    title: "Popular Calculators",
    subtitle: "Power & Current",
    footer: "View all popular tools",
    footerUrl: "/site-map/",
    links: [
      { label: "Watts to Amps", url: "/watts-to-amps-calculator/" },
      { label: "Amps to kW", url: "/amps-to-kw-calculator/" },
      { label: "kW to Amps", url: "/kw-to-amps-calculator/" },
      { label: "kVA to Watts", url: "/kva-to-watts-calculator/" },
      { label: "Voltage Drop", url: "/voltage-drop-calculator/" },
      { label: "Wire Gauge Calculator", url: "/wire-gauge-calculator/" },
    ],
  },
  {
    tone: "blue",
    icon: "battery",
    title: "Energy Calculators",
    subtitle: "Storage & Cost",
    footer: "Explore energy tools",
    footerUrl: "/amp-hours-to-watt-hours/",
    links: [
      { label: "Amp Hours to Watt Hours", url: "/amp-hours-to-watt-hours/" },
      {
        label: "Amp Power Consumption",
        url: "/amp-power-consumption-calculator/",
      },
      { label: "Watts to Amps", url: "/watts-to-amps-calculator/" },
      { label: "Solar Watts to Amps", url: "/solar-watts-to-amps-calculator/" },
      { label: "kW to Amps", url: "/kw-to-amps-calculator/" },
    ],
  },
  {
    tone: "gold",
    icon: "sun",
    title: "Solar Calculators",
    subtitle: "Renewable Power",
    footer: "Explore solar tools",
    footerUrl: "/solar-watts-to-amps-calculator/",
    links: [
      { label: "Solar Watts to Amps", url: "/solar-watts-to-amps-calculator/" },
      { label: "12V Amps to Watts", url: "/12v-amps-to-watts/" },
      { label: "24V Amps to Watts", url: "/24v-amps-to-watts/" },
      { label: "Amp Hours to Watt Hours", url: "/amp-hours-to-watt-hours/" },
      { label: "Wire Gauge Calculator", url: "/wire-gauge-calculator/" },
    ],
  },
];

const conversionRows = [
  ["1A", "12V", "12W"],
  ["5A", "12V", "60W"],
  ["10A", "12V", "120W"],
  ["1A", "120V", "120W"],
  ["5A", "120V", "600W"],
  ["10A", "120V", "1,200W"],
  ["10A", "240V", "2,400W"],
  ["30A", "240V", "7,200W"],
