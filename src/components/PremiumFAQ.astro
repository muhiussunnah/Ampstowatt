---
import type { Tool } from '@/data/tools';
import { getFaqQuestions } from '@/lib/faq';

type Props = {
  tool?: Tool;
  title?: string;
};

const { tool, title = 'Frequently Asked Questions' } = Astro.props;
const name = tool?.shortTitle ?? title;
const heading = tool ? `${name} FAQ` : title;
const ariaLabel = heading.toLowerCase().endsWith('faq') ? heading : `${heading} FAQ`;
const questions = getFaqQuestions(tool);
---

<section class="premium-faq-section" id="faq" aria-label={ariaLabel}>
  <div class="premium-faq-heading">
    <p class="premium-kicker" data-i18n={!tool ? 'faq.kicker' : undefined}>FAQ</p>
    <h2 data-i18n={!tool ? 'faq.title' : undefined}>{heading}</h2>
    <p data-i18n={!tool ? 'faq.desc' : undefined}>Fast answers before you use the calculator or compare formulas.</p>
  </div>
  <div class="premium-faq-list">
    {questions.map((item, index) => (
      <details open={index === 0}>
        <summary>
          <span class="faq-summary-inner">
            <span class="faq-badge">{item.icon}</span>
            {item.q}
          </span>
        </summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>

