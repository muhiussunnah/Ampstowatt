---
import type { Tool } from "@/data/tools";
import ElectricalVisualSystem from "@/components/ElectricalVisualSystem.astro";

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const voltage = tool.defaultVoltage ?? 120;
const phaseLabel =
  tool.defaultPhase === "ac3"
    ? "three-phase AC"
    : tool.defaultPhase === "dc"
      ? "DC"
      : "single-phase AC";

function guideFor(tool: Tool) {
  if (tool.slug.includes("solar")) {
    return {
      quick:
        "Use this calculator to separate panel-side current from battery-side charging current.",
      detail:
        "Solar systems can show different amps at the panel, charge controller, and battery. Enter the voltage point you are sizing so the result matches the wire, fuse, controller, or battery cable you are checking.",
      inputs: [
        "Use panel Vmp for panel-side string current.",
        "Use battery bank voltage for battery-side charging current.",
        "Account for MPPT or PWM controller efficiency before selecting fuses or wire.",
        "Check controller current ratings above the calculated output current.",
      ],
      mistake:
        "Do not use 12V battery voltage to size the solar panel input cable when the panel is actually operating near 18V, 30V, or 40V.",
      result:
        "Read the amp result as a planning value, then add equipment-specific safety margin for heat, cable length, and controller limits.",
    };
  }

  if (tool.slug.includes("led")) {
    return {
      quick:
        "Use this calculator to size LED driver current and low-voltage wiring.",
      detail:
        "LED strips and lamps often run at 12V or 24V DC. The current result helps check driver capacity, wire gauge, voltage drop, and connector limits.",
      inputs: [
        "Use the total LED wattage after adding all strips or fixtures.",
        "Match the voltage to the driver output, usually 12V or 24V.",
        "Leave driver headroom instead of running the supply at its full rating.",
        "Check long strip runs for voltage drop and uneven brightness.",
      ],
      mistake:
        "Do not size a driver from one strip section if multiple strips are connected to the same supply.",
      result:
        "Use the calculated amps to choose a driver, fuse, connector, and wire size with headroom.",
    };
  }

  if (tool.slug.includes("speaker")) {
    return {
      quick:
        "Use this calculator to estimate amplifier supply current, fuse size, and power draw.",
      detail:
        "Speaker output watts are not the same as supply watts. Efficiency, voltage, impedance, and amplifier class change the current the electrical system must provide.",
      inputs: [
        "Use RMS amplifier power rather than peak marketing watts.",
        "Enter supply voltage from the actual battery or power supply.",
        "Use realistic amplifier efficiency for Class AB or Class D systems.",
        "Check speaker impedance so the amplifier is operating in its rated range.",
      ],
      mistake:
        "Do not assume a 500W audio amplifier draws only 500 / 12 amps; efficiency loss and voltage sag increase current.",
      result:
        "Use the current estimate for fuse planning, cable sizing, and battery load checks.",
    };
  }

  if (tool.kind === "voltage-drop") {
    return {
      quick:
        "Use this calculator to estimate voltage lost across a wire run before the load.",
      detail:
        "Voltage drop depends on current, one-way distance, conductor material, wire size, and system voltage. A small voltage loss can matter more in 12V and 24V systems than in 120V or 240V circuits.",
      inputs: [
        "Use one-way conductor distance unless the calculator specifically asks for round-trip length.",
        "Choose copper or aluminum to match the installed conductor.",
        "Enter the expected load current, not only breaker rating.",
        "Compare the percentage drop with the tolerance of the equipment.",
      ],
      mistake:
        "Do not ignore distance on low-voltage DC circuits; long runs can lose useful power even when the amp value looks small.",
      result:
        "Use the result to compare conductor sizes, then verify ampacity, temperature, terminals, and code rules.",
    };
  }

  if (tool.kind === "wire-gauge") {
    return {
      quick:
        "Use this calculator to choose a practical wire gauge for current and distance.",
      detail:
        "Wire gauge selection should consider both ampacity and voltage drop. The calculator helps narrow the planning range before final code and installation checks.",
      inputs: [
        "Enter continuous current, not only short startup current.",
        "Set the voltage and allowed drop for the equipment being powered.",
        "Choose conductor material and installation conditions carefully.",
        "Verify terminal ratings, insulation, bundling, and ambient temperature.",
      ],
      mistake:
        "Do not choose wire from ampacity alone on long runs; voltage drop may require a larger conductor.",
      result:
        "Use the recommendation as a planning reference, then verify the final conductor against local electrical code.",
    };
  }

  if (tool.kind === "amp-hours") {
    return {
      quick:
        "Use this calculator to convert battery capacity into usable energy and runtime context.",
      detail:
        "Amp-hours only describe current over time. Multiplying by voltage converts capacity into watt-hours, which is easier to compare with appliance and inverter loads.",
      inputs: [
        "Use the battery nominal voltage for Wh estimates.",
        "Apply efficiency loss for inverters, converters, and charging.",
        "Check usable capacity limits for lead-acid or lithium batteries.",
        "Compare Wh with the actual wattage and runtime of the load.",
      ],
      mistake:
        "Do not compare amp-hours across different voltages without converting both batteries to watt-hours.",
      result:
        "Use Wh and kWh results to compare batteries, estimate runtime, and plan charging needs.",
    };
  }

  if (
    tool.kind === "power-factor" ||
    tool.kind === "kva-to-watts" ||
    tool.kind === "volt-amps"
  ) {
    return {
      quick: "Use this calculator to separate real watts from apparent power.",
      detail:
        "AC equipment can draw VA or kVA that is higher than usable watts. Power factor explains the difference and is critical for generators, UPS systems, motors, and transformers.",
      inputs: [
        "Use nameplate VA, kVA, or amperage where available.",
        "Enter a realistic PF for motors, compressors, UPS systems, and generators.",
        "Account for startup surge separately from running watts.",
        "Compare real watts with equipment output ratings.",
      ],
      mistake: "Do not treat kVA as kW unless the power factor is 1.00.",
      result:
        "Use the result to avoid undersizing generators, UPS units, and AC power equipment.",
    };
  }

  if (
    tool.defaultPhase === "ac3" ||
    tool.slug.includes("3-phase") ||
    tool.slug.includes("megawatts")
  ) {
    return {
      quick:
        "Use this calculator for balanced three-phase loads using line-to-line voltage.",
      detail:
        "Three-phase power uses the square-root-of-three multiplier when voltage is measured line to line. Motors and industrial loads also need realistic power factor.",
      inputs: [
        "Use line-to-line voltage unless the calculator is set to line-to-neutral.",
        "Enter running current from measured values or equipment nameplate.",
        "Use motor or equipment PF instead of assuming 1.00.",
        "Check whether the load is balanced across phases.",
      ],
      mistake:
        "Do not mix line-to-line and line-to-neutral voltage in the same formula.",
      result:
        "Use the calculated watts or kW for load planning, generator sizing, and panel capacity checks.",
    };
  }

  if (
    tool.defaultPhase === "dc" ||
    tool.slug.includes("12v") ||
    tool.slug.includes("dc")
  ) {
    return {
      quick:
        "Use this calculator when DC current and voltage convert directly into watts.",
      detail:
        "DC systems do not use power factor, so the calculation is direct. This is useful for batteries, automotive systems, LED drivers, electronics, and solar DC accessories.",
      inputs: [
        "Use measured voltage when battery voltage is above or below nominal.",
        "Enter continuous current for heat and runtime planning.",
        "Check fuse and wire ratings against the calculated current.",
        "For battery loads, convert watts into Wh for runtime estimates.",
      ],
      mistake:
        "Do not assume a 12V battery is always exactly 12.0V; charging and resting voltage can change the watt result.",
      result:
        "Use the watt output to compare loads, size power supplies, and estimate battery energy use.",
    };
  }

  return {
    quick:
      "Use this calculator to convert AC current into real watts with voltage and power factor.",
    detail:
      "Single-phase AC loads can be resistive or inductive. Resistive loads may be near PF 1.00, while motors, compressors, and HVAC equipment often need a lower power factor.",
    inputs: [
      "Use the correct nominal voltage for the circuit.",
      "Enter measured current or nameplate running current.",
      "Use realistic PF for motors, compressors, and transformer loads.",
      "Compare the result with breaker and continuous-load limits.",
    ],
    mistake:
      "Do not use DC-style amps x volts for every AC load when the equipment has a lower power factor.",
    result:
      "Use the watt result for appliance planning, branch-circuit checks, and comparison with the main amps to watts formula.",
  };
}

function exampleFor(tool: Tool) {
  switch (tool.kind) {
    case "watts-to-amps":
      return {
        title: `Example: 1,200 watts at ${voltage} volts`,
        body: `At ${voltage} volts, a 1,200 watt load draws ${Number((1200 / voltage).toFixed(2)).toLocaleString()} amps before AC power-factor adjustments. Use the power factor field when the equipment is a motor, compressor, inverter, or other inductive load.`,
      };
    case "amp-hours":
      return {
        title: "Example: battery energy estimate",
        body: `A 100 Ah battery at ${voltage} volts stores about ${Number((100 * voltage).toFixed(0)).toLocaleString()} watt-hours before efficiency losses. Use the result for runtime planning, then check the battery data sheet for usable capacity limits.`,
      };
    case "volt-amps":
      return {
        title: `Example: 10 amps at ${voltage} volts`,
        body: `At ${voltage} volts, 10 amps equals ${Number((10 * voltage).toFixed(0)).toLocaleString()} VA. For real watts, multiply apparent power by power factor.`,
      };
    case "voltage-drop":
      return {
        title: "Example: long wire run planning",
        body: "Enter current, one-way distance, system voltage, conductor material, and wire size. The calculator estimates voltage lost in the run so you can compare it with a practical voltage-drop limit before choosing cable size.",
      };
    case "wire-gauge":
      return {
        title: "Example: choosing a practical wire gauge",
        body: "Start with current, distance, voltage, conductor material, and allowed voltage drop. The calculator gives a planning reference, but final conductor sizing must account for ampacity, temperature, bundling, terminals, and local code.",
      };
    case "power-factor":
      return {
        title: "Example: real power vs apparent power",
        body: "If equipment uses 800 W from 1,000 VA, the power factor is 0.80. Use that value when converting AC amps to watts or watts to amps for motors, HVAC, and generators.",
      };
    case "kva-to-watts":
      return {
        title: "Example: generator output",
        body: "A 5 kVA generator at 0.80 power factor can supply about 4,000 watts of real power. Always compare calculator output with the generator nameplate and startup surge requirements.",
      };
    case "amps-to-kw":
      return {
        title: `Example: 10 amps at ${voltage} volts`,
        body: `At ${voltage} volts, 10 amps equals ${Number(((10 * voltage) / 1000).toFixed(3)).toLocaleString()} kW before AC power-factor adjustments.`,
      };
    default:
      return {
        title: `Example: 10 amps at ${voltage} volts`,
        body: `At ${voltage} volts, 10 amps equals ${Number((10 * voltage).toFixed(0)).toLocaleString()} watts before AC power-factor adjustments. Formula: 10 A x ${voltage} V = ${Number((10 * voltage).toFixed(0)).toLocaleString()} W.`,
      };
  }
}

const example = exampleFor(tool);
const guide = guideFor(tool);
const uses =
  tool.highlights.length > 0
    ? tool.highlights
    : [
        "Fast planning result",
        "Formula-first workflow",
        "Clear units and result summary",
      ];
---

<section
  class="content-section tool-premium-guide"
  aria-labelledby={`${tool.slug}-premium-guide`}
>
  <article class="content-card tool-guide-card">
    <div class="section-divider">
      <div class="icon-circle" aria-hidden="true">GUIDE</div>
      <h2 id={`${tool.slug}-premium-guide`}>{tool.title} Guide</h2>
      <div class="line" aria-hidden="true"></div>
    </div>

    <ElectricalVisualSystem tool={tool} />

    <div class="tool-guide-grid">
      <section class="tool-guide-panel tool-guide-panel--answer">
        <p class="premium-kicker">Quick answer</p>
        <h3>{guide.quick}</h3>
        <p>{guide.detail}</p>
        <div class="tool-guide-formula">{tool.formula}</div>
      </section>

      <section class="tool-guide-panel">
        <h3>Inputs to check before calculating</h3>
        <ul>
          {guide.inputs.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="tool-guide-panel">
        <h3>{example.title}</h3>
        <p>{example.body}</p>
      </section>

      <section class="tool-guide-panel">
        <h3>Best use cases</h3>
        <ul>
          {uses.map((item) => <li>{item}</li>)}
          <li>{phaseLabel} load planning with clear unit labels.</li>
        </ul>
      </section>

      <section class="tool-guide-panel">
        <h3>Common mistake to avoid</h3>
        <p>{guide.mistake}</p>
      </section>

      <section class="tool-guide-panel">
        <h3>How to use the result</h3>
        <p>{guide.result}</p>
      </section>
    </div>

    <div class="tool-guide-safety">
      <strong>Accuracy and safety note</strong>
      <p>
        Calculator output is a planning estimate. Final breaker sizing, wire
        gauge, derating, voltage-drop limits, equipment protection, and code
        compliance should be verified with manufacturer documentation and a
        qualified electrician or engineer.
      </p>
      <p>
        For the broad formula, reference table, and breaker planning context,
        start with the <a href="/">main Amps to Watts Calculator</a>.
      </p>
    </div>
  </article>
</section>
