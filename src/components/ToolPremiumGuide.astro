---
import type { Tool } from '@/data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const voltage = tool.defaultVoltage ?? 120;
const phaseLabel = tool.defaultPhase === 'ac3'
  ? 'three-phase AC'
  : tool.defaultPhase === 'dc'
    ? 'DC'
    : 'single-phase AC';

function exampleFor(tool: Tool) {
  switch (tool.kind) {
    case 'watts-to-amps':
      return {
        title: `Example: 1,200 watts at ${voltage} volts`,
        body: `At ${voltage} volts, a 1,200 watt load draws ${Number((1200 / voltage).toFixed(2)).toLocaleString()} amps before AC power-factor adjustments. Use the power factor field when the equipment is a motor, compressor, inverter, or other inductive load.`
      };
    case 'amp-hours':
      return {
        title: 'Example: battery energy estimate',
        body: `A 100 Ah battery at ${voltage} volts stores about ${Number((100 * voltage).toFixed(0)).toLocaleString()} watt-hours before efficiency losses. Use the result for runtime planning, then check the battery data sheet for usable capacity limits.`
      };
    case 'volt-amps':
      return {
        title: `Example: 10 amps at ${voltage} volts`,
        body: `At ${voltage} volts, 10 amps equals ${Number((10 * voltage).toFixed(0)).toLocaleString()} VA. For real watts, multiply apparent power by power factor.`
      };
    case 'voltage-drop':
      return {
        title: 'Example: long wire run planning',
        body: 'Enter current, one-way distance, system voltage, conductor material, and wire size. The calculator estimates voltage lost in the run so you can compare it with a practical voltage-drop limit before choosing cable size.'
      };
    case 'wire-gauge':
      return {
        title: 'Example: choosing a practical wire gauge',
        body: 'Start with current, distance, voltage, conductor material, and allowed voltage drop. The calculator gives a planning reference, but final conductor sizing must account for ampacity, temperature, bundling, terminals, and local code.'
      };
    case 'power-factor':
      return {
        title: 'Example: real power vs apparent power',
        body: 'If equipment uses 800 W from 1,000 VA, the power factor is 0.80. Use that value when converting AC amps to watts or watts to amps for motors, HVAC, and generators.'
      };
    case 'kva-to-watts':
      return {
        title: 'Example: generator output',
        body: 'A 5 kVA generator at 0.80 power factor can supply about 4,000 watts of real power. Always compare calculator output with the generator nameplate and startup surge requirements.'
      };
    case 'amps-to-kw':
      return {
        title: `Example: 10 amps at ${voltage} volts`,
        body: `At ${voltage} volts, 10 amps equals ${Number(((10 * voltage) / 1000).toFixed(3)).toLocaleString()} kW before AC power-factor adjustments.`
      };
    default:
      return {
        title: `Example: 10 amps at ${voltage} volts`,
        body: `At ${voltage} volts, 10 amps equals ${Number((10 * voltage).toFixed(0)).toLocaleString()} watts before AC power-factor adjustments. Formula: 10 A x ${voltage} V = ${Number((10 * voltage).toFixed(0)).toLocaleString()} W.`
      };
  }
}

const example = exampleFor(tool);
const uses = tool.highlights.length > 0 ? tool.highlights : ['Fast planning result', 'Formula-first workflow', 'Clear units and result summary'];
---

<section class="content-section tool-premium-guide" aria-labelledby={`${tool.slug}-premium-guide`}>
  <article class="content-card tool-guide-card">
    <div class="section-divider">
      <div class="icon-circle" aria-hidden="true">GUIDE</div>
      <h2 id={`${tool.slug}-premium-guide`}>{tool.title} Guide</h2>
      <div class="line" aria-hidden="true"></div>
    </div>

    <div class="tool-guide-grid">
      <section class="tool-guide-panel tool-guide-panel--answer">
        <p class="premium-kicker">Quick answer</p>
        <h3>Use this calculator when you need a fast, formula-backed electrical planning result.</h3>
        <p>{tool.description}</p>
        <div class="tool-guide-formula">{tool.formula}</div>
      </section>

      <section class="tool-guide-panel">
        <h3>Inputs to check before calculating</h3>
        <ul>
          <li>Use measured or nameplate values where possible.</li>
          <li>Choose the correct circuit type: DC, single-phase AC, or three-phase AC.</li>
          <li>For AC loads, enter a realistic power factor instead of assuming every load is 1.00.</li>
          <li>Use the same voltage convention consistently, especially for three-phase line-to-line systems.</li>
        </ul>
      </section>

      <section class="tool-guide-panel">
        <h3>{example.title}</h3>
        <p>{example.body}</p>
      </section>

      <section class="tool-guide-panel">
        <h3>Best use cases</h3>
        <ul>
          {uses.map((item) => <li>{item}</li>)}
          <li>{phaseLabel} load planning with clear unit labels.</li>
        </ul>
      </section>
    </div>

    <div class="tool-guide-safety">
      <strong>Accuracy and safety note</strong>
      <p>Calculator output is a planning estimate. Final breaker sizing, wire gauge, derating, voltage-drop limits, equipment protection, and code compliance should be verified with manufacturer documentation and a qualified electrician or engineer.</p>
      <p>For the broad formula, reference table, and breaker planning context, start with the <a href="/">main Amps to Watts Calculator</a>.</p>
    </div>
  </article>
</section>
