---
import '../styles/site.css';
import { tools } from '@/data/tools';
import type { Tool } from '@/data/tools';
import PremiumFAQ from '@/components/PremiumFAQ.astro';
import AmpsToWattsCalculator from '@/components/AmpsToWattsCalculator.astro';
import HomepageLanguageSwitcher from '@/components/HomepageLanguageSwitcher.astro';
import { getFaqQuestions } from '@/lib/faq';
import type { FaqItem } from '@/lib/faq';

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  keywords?: string;
  legacyMode?: boolean;
  tool?: Tool;
  showCalculator?: boolean;
  kicker?: string;
  h1Title?: string;
  noindex?: boolean;
};

const { 
  title, 
  description, 
  canonicalPath = '/', 
  keywords = '', 
  legacyMode = false,
  tool,
  showCalculator = false,
  kicker = 'Premium electrical calculator suite',
  h1Title = title.replace(' | Amps To Watts Calculator', '').replace(' — Convert Amps to Watts Instantly', ''),
  noindex = false
} = Astro.props;

const siteUrl = 'https://www.ampstowatt.com';
const faqQuestions = getFaqQuestions(tool);

const canonical = new URL(canonicalPath, siteUrl).toString();
const image = new URL('/og-image.jpg', siteUrl).toString();
const datePublished = '2024-06-15';
const dateModified = '2026-06-12';
const referenceSources = [
  'https://www.nist.gov/pml/weights-and-measures/si-units-ampere',
  'https://www.cdc.gov/niosh/electrical-safety/index.html',
  'https://www.osha.gov/etools/subpart-s'
];

/* Breadcrumb */
const isHome = canonicalPath === '/';
const pageTitle = title.replace(' | Amps To Watts Calculator', '').replace(' - Amps To Watts Calculator', '');
const currentSlug = canonicalPath.replace(/^\/|\/$/g, '');
const breadcrumbPageTitle = h1Title
  .replace(' | Amps To Watts Calculator', '')
  .replace(' - Amps To Watts Calculator', '')
  .replace(' | Ampstowatt', '');

type BreadcrumbItem = {
  name: string;
  href?: string;
};

const coreConversionSlugs = new Set([
  'amps-to-watts-formula',
  'conversion-charts',
  'amps-vs-watts',
  'how-many-watts-per-amp',
  'ac-amps-to-watts-calculator',
  'dc-amps-to-watts-calculator',
  'single-phase-amps-to-watts',
  '3-phase-amps-to-watts-calculator'
]);
const voltageSlugs = new Set([
  '12v-amps-to-watts',
  '24v-amps-to-watts',
  '120v-amps-to-watts',
  '220v-amps-to-watts',
  '230v-amps-to-watts',
  '240v-amps-to-watts',
  '480v-amps-to-watts-calculator'
]);
const applicationSlugs = new Set([
  'solar-watts-to-amps-calculator',
  'led-watts-to-amps-calculator',
  'speaker-amp-power-calculator',
  'air-conditioner-amps-to-watts',
  'generator-amps-to-watts',
  'ev-charger-amps-to-watts',
  'motor-amps-to-watts',
  'electric-motor-amps-to-watts',
  'refrigerator-amps-to-watts',
  'microwave-amps-to-watts',
  'dryer-amps-to-watts',
  'pool-pump-amps-to-watts'
]);
const reverseSlugs = new Set([
  'watts-to-amps-calculator',
  'watts-to-amps-12v',
  'watts-to-amps-120v',
  'watts-to-amps-240v',
  'amps-to-kw-calculator',
  'kw-to-amps-calculator',
  'amps-to-volt-amps',
  'kva-to-watts-calculator',
  'megawatts-to-amps-calculator',
  'amp-hours-to-watt-hours',
  'amp-power-consumption-calculator',
  'other-voltages-calculator'
]);
const knowledgeSlugs = new Set([
  'what-are-amps',
  'what-are-watts',
  'ohms-law-explained',
  'watts-law-explained',
  'kwh-explained',
  'power-factor',
  'power-factor-explained',
  'understanding-power-factor'
]);
const safetySlugs = new Set(['wire-gauge-calculator', 'voltage-drop-calculator']);
const blogSlugs = new Set([
  'blog',
  'blog/amps-to-watts-conversion-chart-pdf',
  'blog/circuit-breaker-safety-guide',
  'blog/ev-charging-at-home-electrical-guide',
  'blog/understanding-solar-panel-wiring'
]);

function buildBreadcrumbTrail(): BreadcrumbItem[] {
  const trail: BreadcrumbItem[] = [{ name: 'Home', href: '/' }];

  if (isHome) {
    return trail;
  }

  if (voltageSlugs.has(currentSlug)) {
    trail.push({ name: 'Amps to Watts', href: '/#related-calculators' });
    trail.push({ name: 'Voltage Calculators', href: '/#topical-voltage-calculators' });
  } else if (applicationSlugs.has(currentSlug)) {
    trail.push({ name: 'Amps to Watts', href: '/#related-calculators' });
    trail.push({ name: 'Application Calculators', href: '/#topical-application-calculators' });
  } else if (coreConversionSlugs.has(currentSlug)) {
    trail.push({ name: 'Amps to Watts', href: '/#topical-main-conversion' });
  } else if (reverseSlugs.has(currentSlug)) {
    trail.push({ name: 'Electrical Conversions', href: '/#topical-reverse-conversions' });
  } else if (knowledgeSlugs.has(currentSlug)) {
    trail.push({ name: 'Electrical Guides', href: '/#topical-guides' });
  } else if (safetySlugs.has(currentSlug)) {
    trail.push({ name: 'Electrical Tools', href: '/#topical-safety-tools' });
  } else if (blogSlugs.has(currentSlug)) {
    if (currentSlug !== 'blog') {
      trail.push({ name: 'Blog', href: '/blog/' });
    }
  }

  trail.push({ name: breadcrumbPageTitle });
  return trail;
}

const breadcrumbTrail = buildBreadcrumbTrail();
const breadcrumbSchemaItems = breadcrumbTrail.map((item, index) => {
  const isLast = index === breadcrumbTrail.length - 1;
  return {
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: isLast ? canonical : new URL(item.href ?? '/', siteUrl).toString()
  };
});

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Amps To Watts Calculator',
      url: `${siteUrl}/`,
      publisher: { '@id': `${siteUrl}/#organization` }
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Amps To Watts Calculator',
      url: `${siteUrl}/`,
      description: 'Free premium electrical calculators for current, voltage, watts, kW, VA, battery energy, wire sizing, and voltage drop. Educational resource for electrical planning.',
      foundingDate: '2024',
      logo: {
        '@type': 'ImageObject',
        url: new URL('/favicon.svg', siteUrl).toString()
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        url: `${siteUrl}/contact-us/`
      }
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      author: { '@id': `${siteUrl}/#organization` },
      publisher: { '@id': `${siteUrl}/#organization` },
      about: { '@id': `${canonical}#application` },
      inLanguage: 'en-US',
      datePublished,
      dateModified,
      reviewedBy: { '@id': `${siteUrl}/#organization` },
      citation: isHome ? referenceSources : undefined,
      primaryImageOfPage: { '@id': `${canonical}#primaryimage` },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['.content-lead', '.home-formula-card strong', '#quick-answer']
      }
    },
    {
      '@type': 'ImageObject',
      '@id': `${canonical}#primaryimage`,
      url: image,
      width: 1200,
      height: 630
    },
    ...(!isHome ? [{
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbSchemaItems
    }] : []),
    {
      '@type': 'WebApplication',
      '@id': `${canonical}#application`,
      name: title,
      url: canonical,
      applicationCategory: 'UtilitiesApplication',
      applicationSubCategory: 'Calculator',
      operatingSystem: 'All',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description,
      featureList: [
        'Amps to watts conversion',
        'DC, single-phase AC, and three-phase AC formulas',
        'Power factor support',
        'Conversion table and breaker-safety planning notes'
      ],
      isAccessibleForFree: true,
      publisher: { '@id': `${siteUrl}/#organization` }
    },
    ...(faqQuestions.length > 0 ? [{
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqQuestions.map((item: FaqItem) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a
        }
      }))
    }] : []),
    ...(isHome ? [{
      '@type': 'HowTo',
      '@id': `${canonical}#howto`,
      name: 'How to Convert Amps to Watts',
      description: 'Convert electrical current in amps to power in watts using the correct formula for DC, single-phase AC, or three-phase AC circuits.',
      totalTime: 'PT1M',
      tool: [{ '@type': 'HowToTool', name: 'Amps to Watts Calculator' }],
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Find the current in amps',
          text: 'Read the current draw from the equipment nameplate, a clamp meter, or the circuit breaker rating. If the reading is in milliamps (mA), divide by 1,000.'
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Find the voltage',
          text: 'Identify the supply voltage. Common values are 12V (batteries), 120V (US outlets), 220V–240V (international), or 400V–480V (three-phase industrial).'
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Determine the circuit type',
          text: 'Determine if the circuit is DC (battery, solar) or AC (wall outlet, motor). For AC, identify single-phase or three-phase.'
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Find the power factor (AC only)',
          text: 'Check the equipment nameplate for PF or cos(φ). Resistive loads have PF ≈ 1.0. Motors typically range from 0.70 to 0.95. Use 0.85 if unknown.'
        },
        {
          '@type': 'HowToStep',
          position: 5,
          name: 'Multiply using the correct formula',
          text: 'For DC: Watts = Amps × Volts. For AC single-phase: Watts = Amps × Volts × PF. For AC three-phase: Watts = 1.732 × Amps × Volts × PF.'
        }
      ]
    }] : []),
    ...(tool ? [{
      '@type': 'TechArticle',
      '@id': `${canonical}#article`,
      headline: title,
      description,
      author: { '@id': `${siteUrl}/#organization` },
      publisher: { '@id': `${siteUrl}/#organization` },
      datePublished,
      dateModified,
      mainEntityOfPage: { '@id': `${canonical}#webpage` },
      inLanguage: 'en-US',
      about: {
        '@type': 'Thing',
        name: tool.shortTitle,
        description: tool.description
      }
    }] : [])
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}
    <meta name="author" content="Amps To Watts Calculator" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#05070d" />
    <meta name="google-site-verification" content="J08lQRurbjNvR9mj7ufDcG3f7ErT-jhPPuOLeGX5WOE" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Amps To Watts Calculator" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <!-- Scroll progress bar -->
    <div class="scroll-progress" id="scroll-progress"></div>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <!-- ===== HEADER ===== -->
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark">AW</span>
        <span>
          <strong>Amps To Watts</strong>
          <small data-i18n="brand.small">Premium electrical calculators</small>
        </span>
      </a>
      <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
      <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
        <a href="/" data-i18n="nav.home">Home</a>
        
        <details class="nav-dropdown">
          <summary>Calculators</summary>
          <div class="dropdown-menu">
            <a href="/ac-amps-to-watts-calculator/">AC Amps to Watts</a>
            <a href="/dc-amps-to-watts-calculator/">DC Amps to Watts</a>
            <a href="/single-phase-amps-to-watts/">Single Phase Amps to Watts</a>
            <a href="/3-phase-amps-to-watts-calculator/">3 Phase Amps to Watts</a>
            <a href="/watts-to-amps-calculator/">Watts to Amps</a>
            <a href="/amps-to-kw-calculator/">Amps to kW</a>
            <a href="/kw-to-amps-calculator/">kW to Amps</a>
            <a href="/kva-to-watts-calculator/">kVA to Watts</a>
          </div>
        </details>

        <details class="nav-dropdown">
          <summary>Voltage Calculators</summary>
          <div class="dropdown-menu">
            <a href="/12v-amps-to-watts/">12V Amps to Watts</a>
            <a href="/24v-amps-to-watts/">24V Amps to Watts</a>
            <a href="/120v-amps-to-watts/">120V Amps to Watts</a>
            <a href="/220v-amps-to-watts/">220V Amps to Watts</a>
            <a href="/230v-amps-to-watts/">230V Amps to Watts</a>
            <a href="/240v-amps-to-watts/">240V Amps to Watts</a>
            <a href="/480v-amps-to-watts-calculator/">480V Amps to Watts</a>
          </div>
        </details>

        <details class="nav-dropdown">
          <summary>Appliance Calculators</summary>
          <div class="dropdown-menu">
            <a href="/air-conditioner-amps-to-watts/">Air Conditioner</a>
            <a href="/generator-amps-to-watts/">Generator</a>
            <a href="/ev-charger-amps-to-watts/">EV Charger</a>
            <a href="/motor-amps-to-watts/">Motor</a>
            <a href="/electric-motor-amps-to-watts/">Electric Motor</a>
            <a href="/refrigerator-amps-to-watts/">Refrigerator</a>
            <a href="/microwave-amps-to-watts/">Microwave</a>
            <a href="/dryer-amps-to-watts/">Dryer</a>
            <a href="/pool-pump-amps-to-watts/">Pool Pump</a>
            <a href="/solar-watts-to-amps-calculator/">Solar</a>
            <a href="/led-watts-to-amps-calculator/">LED</a>
            <a href="/speaker-amp-power-calculator/">Speaker</a>
          </div>
        </details>

        <details class="nav-dropdown">
          <summary>Electrical Guides</summary>
          <div class="dropdown-menu">
            <a href="/what-are-amps/">What Are Amps?</a>
            <a href="/what-are-watts/">What Are Watts?</a>
            <a href="/amps-vs-watts/">Amps vs Watts</a>
            <a href="/ohms-law-explained/">Ohm's Law</a>
            <a href="/watts-law-explained/">Watt's Law</a>
            <a href="/power-factor/">Power Factor</a>
            <a href="/kwh-explained/">kWh Explained</a>
            <a href="/wire-gauge-calculator/">Wire Gauge</a>
            <a href="/voltage-drop-calculator/">Voltage Drop</a>
          </div>
        </details>

        <a href="/blog/">Blog</a>
        <a href="/contact-us/">Contact</a>
      </nav>
    </header>

    <!-- ===== BREADCRUMB ===== -->
    {!isHome && (
      <div class="breadcrumb-bar">
        <nav aria-label="Breadcrumb">
          {breadcrumbTrail.map((item, index) => (
            <>
              {index > 0 && <span class="breadcrumb-sep" aria-hidden="true">/</span>}
              {index < breadcrumbTrail.length - 1 && item.href ? (
                <a href={item.href}>{item.name}</a>
              ) : (
                <span class="breadcrumb-current">{item.name}</span>
              )}
            </>
          ))}
        </nav>
      </div>
    )}

    <!-- ===== MAIN ===== -->
    <main id="main-content" class={legacyMode ? 'legacy-shell' : ''}>
      <div class="legacy-content">
        <!-- H1 and Tool Section (Immediately above fold) -->
        {showCalculator && (
          <section class="premium-unified-hero">
            <div class="premium-hero-copy">
              <p class="premium-kicker" data-i18n={isHome ? 'hero.kicker' : undefined}>{kicker}</p>
              <h1 data-i18n={isHome ? 'hero.title' : undefined}>{h1Title}</h1>
              {tool && <div class="premium-formula-pill">{tool.formula}</div>}
              <p data-i18n={isHome ? 'hero.description' : undefined}>{description}</p>
            </div>
            <AmpsToWattsCalculator tool={tool} />
          </section>
        )}
        
        <slot />
      </div>
    </main>

    <!-- ===== FAQ (Always at the bottom) ===== -->
    <div class={legacyMode ? 'legacy-shell' : ''}>
      <div class="legacy-content legacy-content--flush">
        <PremiumFAQ tool={tool} />
      </div>
    </div>

    <!-- ===== FOOTER ===== -->
    <div class="footer-wrapper">
      <footer class="site-footer">
        {isHome && <HomepageLanguageSwitcher placement="footer" />}
        <div>
          <a class="footer-brand" href="/">Amps To Watts Calculator</a>
          <p>Premium electrical calculators for current, voltage, watts, kW, VA, battery energy, wire sizing, and voltage drop. Educational use only; verify safety-critical work with a licensed professional.</p>
        </div>
        <div>
          <p class="footer-col-title" data-i18n="footer.theory">Theory & Principles</p>
          <nav aria-label="Electrical theory">
            <a href="/ac-amps-to-watts-calculator/">AC Power Dynamics</a>
            <a href="/dc-amps-to-watts-calculator/">DC Systems</a>
            <a href="/3-phase-amps-to-watts-calculator/">Three-Phase Mechanics</a>
            <a href="/power-factor/">Power Factor Guide</a>
            <a href="/kva-to-watts-calculator/">Apparent Power (kVA)</a>
          </nav>
        </div>
        <div>
          <p class="footer-col-title" data-i18n="footer.standards">Circuit Standards</p>
          <nav aria-label="Circuit standards">
            <a href="/12v-amps-to-watts/">Low Voltage (12V)</a>
            <a href="/120v-amps-to-watts/">US Mains (120V)</a>
            <a href="/240v-amps-to-watts/">US Split-Phase (240V)</a>
            <a href="/230v-amps-to-watts/">UK/EU Mains (230V)</a>
          </nav>
        </div>
        <div>
          <p class="footer-col-title" data-i18n="footer.resources">Resources</p>
          <nav aria-label="Resource links">
            <a href="/blog/">Blog & Guides</a>
            <a href="/about-us/">About</a>
            <a href="/privacy-policy/">Privacy</a>
            <a href="/terms-conditions/">Terms</a>
            <a href="/disclaimer/">Disclaimer</a>
            <a href="/site-map/">Site map</a>
          </nav>
        </div>
        <p class="copyright">Copyright 2026 Amps To Watts Calculator. All rights reserved. Built with precision for electrical professionals.</p>
      </footer>
    </div>

    <!-- Back to top -->
    <button class="back-to-top" type="button" aria-label="Back to top" title="Back to top">Top</button>

    <script src="../scripts/app.js"></script>
  </body>
</html>
